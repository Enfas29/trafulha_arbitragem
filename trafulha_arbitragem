def ciclo_scanner():
    print("\n[Scanner Global] A procurar oportunidades em mercados internacionais...")
    mercados = obter_dados_mercados_globais()
    investimento_total = 100.0  # Orçamento base de exemplo em euros
    
    for m in mercados:
        volume = m["volume_polymarket"]
        odd_poly = m["odd_poly"]
        odd_reg = m["odd_reg"]
        
        # Probabilidades implícitas
        prob_poly = 1 / odd_poly
        prob_reg = 1 / odd_reg
        
        # Critério 1: Volume no Polymarket superior a $20,000
        if volume > 20000:
            soma_probabilidades = prob_poly + prob_reg
            
            # Critério 2: Soma das probabilidades inferior a 0.98 (Margem de lucro)
            if soma_probabilidades < 0.98:
                
                # Cálculo exato da stake para cada lado
                stake_poly = investimento_total * (prob_poly / soma_probabilidades)
                stake_reg = investimento_total * (prob_reg / soma_probabilidades)
                
                retorno_poly = stake_poly * odd_poly
                lucro_euros = retorno_poly - investimento_total
                lucro_percentual = (1 - soma_probabilidades) * 100
                
                mensagem = (
                    f"🚨 *Oportunidade Global de Arbitragem!* 🚨\n\n"
                    f"⚽ *Jogo:* {m['evento']}\n"
                    f"📅 *Data e Hora:* {m['data_hora']}\n"
                    f"📊 *Volume Polymarket:* ${volume:,.2f}\n\n"
                    f"👉 *Lado 1 ({m['plataforma_poly']}):*\n"
                    f"   • Aposta: {m['escolha_poly']}\n"
                    f"   • Odd: {odd_poly:.2f}\n"
                    f"   • Valor a colocar: **{stake_poly:.2f}€**\n\n"
                    f"👉 *Lado 2 ({m['casa_regulada']}):*\n"
                    f"   • Aposta: {m['escolha_reg']}\n"
                    f"   • Odd: {odd_reg:.2f}\n"
                    f"   • Valor a colocar: **{stake_reg:.2f}€**\n\n"
                    f"💰 *Investimento Total:* {investimento_total:.2f}€\n"
                    f"🎯 *Retorno Garantido:* ~{retorno_poly:.2f}€\n"
                    f"📈 *Lucro Líquido:* **+{lucro_euros:.2f}€** (~{lucro_percentual:.2f}%)\n\n"
                    f"💡 *Lucro garantido independentemente do resultado!*"
                )
                
                print(f"[ALERTA] Oportunidade detetada e enviada para o Telegram: {m['evento']}")
                enviar_alerta_telegram(mensagem)
            else:
                print(f"[Info] Sem margem rentável em: {m['evento']} (Soma: {soma_probabilidades:.3f})")
        else:
            print(f"[Info] Jogo ignorado por baixo volume: {m['evento']} (${volume:,.2f})")

if __name__ == "__main__":
